# ============================================
# Waselni Backend — PRODUCTION Environment
# ============================================
# Copy to .env.production and fill in REAL values.
# DO NOT commit .env.production to git.

# === App ===
APP_ENV=production
APP_NAME=waselni-backend
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# === Database ===
# These are used by docker-compose.prod.yml to set up the PostgreSQL container.
# The DATABASE_URL is auto-constructed in docker-compose.prod.yml from these.
POSTGRES_USER=waselni
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=waslni

# === JWT / Auth ===
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_256_BIT_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# === CORS ===
# Comma-separated list of allowed origins.
CORS_ORIGINS=https://app.waslni.com,https://waslni.com

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# === Mapbox (optional — for server-side geo validation) ===
MAPBOX_API_KEY=

# === FCM (future — push notifications) ===
FCM_CREDENTIALS_PATH=

# === Logging ===
LOG_LEVEL=WARNING
LOG_FORMAT=json
