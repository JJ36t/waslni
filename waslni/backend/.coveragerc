# .coveragerc — coverage configuration for the Waselni backend.

[run]
source = app
omit =
    app/__init__.py
    app/*/__init__.py
    app/main.py
    app/core/logging.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
show_missing = True
skip_covered = False
precision = 2

[html]
directory = htmlcov
