# ============================================
# Waselni Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env to git.

# === App ===
APP_ENV=development
APP_NAME=waselni-backend
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# === Database ===
DATABASE_URL=postgresql+asyncpg://waselni:waselni@localhost:5432/waslni

# === JWT / Auth ===
JWT_SECRET=change-me-to-a-256-bit-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# === CORS ===
CORS_ORIGINS=http://localhost:8080,http://10.0.2.2:8080

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=100
LOGIN_RATE_LIMIT_PER_MINUTE=5

# === Mapbox (used by sync service for geo-validation if needed) ===
MAPBOX_API_KEY=

# === FCM (later) ===
FCM_CREDENTIALS_PATH=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=json
