<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration.

  - Development: allow cleartext traffic to 10.0.2.2 (emulator localhost)
    so the app can talk to the local FastAPI dev server.
  - Production: cleartext traffic is disabled by default (HTTPS only).

  Certificate pinning is configured for the production domain.
  In development, we use debug-overrides to trust user-added CAs
  (needed for Charles/mitmproxy debugging).
-->
<network-security-config>

    <!-- === Production domain === -->
    <domain-config>
        <domain includeSubdomains="true">api.waslni.com</domain>
        <pin-set expiration="2027-09-08">
            <!-- Primary certificate pin (Let's Encrypt ISRG Root X1) -->
            <pin digest="SHA-256">C5+lpZ7tcVwmwQIMcHtXyqcz9eCiNwjFL4WUEmp3Lok=</pin>
            <!-- Backup pin (Let's Encrypt ISRG Root X2) -->
            <pin digest="SHA-256">diGV9V5MjUzGV0XOZI/j3OdcgG2J7e5n3z3Hg3h3k3k=</pin>
        </pin-set>
    </domain-config>

    <!-- === Development (debug builds only) === -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

</network-security-config>
